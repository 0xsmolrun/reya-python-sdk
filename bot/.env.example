# Reya 15m FVG bot — environment template.
#
# Copy to the repository root as `.env`:
#     cp bot/.env.example .env
#
# Only secrets and endpoints belong here. Strategy, risk and UI settings live in
# config.yaml, which is safe to commit.
#
# NEVER commit a real private key. Anyone holding it controls the account.


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Reya mainnet (real funds)
CHAIN_ID=1729
REYA_API_BASE_URL=https://api.reya.xyz/v2
REYA_WS_URL=wss://ws.reya.xyz/

# Reya testnet (Cronos) — start here
#CHAIN_ID=89346162
#REYA_API_BASE_URL=https://api-cronos.reya.xyz/v2
#REYA_WS_URL=wss://websocket-testnet.reya.xyz/


# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Your Reya margin account id. Find it at:
#     https://api.reya.xyz/v2/wallet/<your_wallet_address>/accounts
ACCOUNT_ID=

# The key that signs orders. Required for live trading only — paper and
# backtest modes read public market data and need no key at all.
PRIVATE_KEY=

# The wallet whose positions, orders and balances the bot reads. Usually the
# address derived from PRIVATE_KEY; it differs only when one address has been
# granted permission to trade on behalf of another.
OWNER_WALLET_ADDRESS=

# The SDK's own variable names are accepted as a fallback, so an existing SDK
# .env keeps working without edits:
#   PERP_ACCOUNT_ID_1, PERP_PRIVATE_KEY_1, PERP_WALLET_ADDRESS_1


# ---------------------------------------------------------------------------
# Alerts (optional) — enable them in config.yaml under `notifier:`
# ---------------------------------------------------------------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#DISCORD_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# WebSocket tuning (optional; sensible defaults are built in)
# ---------------------------------------------------------------------------
#REYA_WS_PING_INTERVAL=20
#REYA_WS_PING_TIMEOUT=15
#REYA_WS_SSL_VERIFY=true
